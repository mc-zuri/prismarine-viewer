{
  "name": "prismarine-viewer",
  "version": "1.33.0",
  "description": "Web based viewer",
  "main": "index.js",
  "scripts": {
    "jestTest": "jest --verbose --runInBand --forceExit",
    "test": "npm run jestTest",
    "pretest": "npm run lint",
    "lint": "standard",
    "prepare": "node viewer/prerender.js && webpack",
    "fix": "standard --fix"
  },
  "author": "PrismarineJS",
  "license": "MIT",
  "standard": {
    "ignore": [
      "examples/electron/",
      "examples/exporter/",
      "examples/standalone/",
      "examples/web_client/"
    ]
  },
  "dependencies": {
    "@tweenjs/tween.js": "^23.1.1",
    "compression": "^1.7.4",
    "express": "^4.17.1",
    "minecraft-data": "github:mc-zuri/minecraft-data-node#bedrock-web-viewer",
    "prismarine-block": "github:mc-zuri/prismarine-block#bedrock-web-viewer",
    "prismarine-chunk": "github:mc-zuri/prismarine-chunk#bedrock-web-viewer",
    "prismarine-registry": "github:mc-zuri/prismarine-registry#bedrock-web-viewer",
    "prismarine-world": "^3.3.1",
    "socket.io": "^4.0.0",
    "socket.io-client": "^4.0.0",
    "three": "0.128.0",
    "three.meshline": "^1.3.0",
    "vec3": "^0.1.7"
  },
  "devDependencies": {
    "assert": "^2.0.0",
    "bedrock-protocol": "github:mc-zuri/bedrock-protocol#bedrock-web-viewer",
    "buffer": "^6.0.3",
    "canvas": "^3.1.0",
    "fs-extra": "^11.0.0",
    "jest": "^29.7.0",
    "jest-puppeteer": "^11.0.0",
    "minecraft-assets": "github:mc-zuri/node-minecraft-assets#bedrock-web-viewer",
    "minecraft-wrap": "^1.3.0",
    "minecrafthawkeye": "^1.2.5",
    "mineflayer": "^4.0.0",
    "mineflayer-pathfinder": "^2.0.0",
    "node-canvas-webgl": "PrismarineJS/node-canvas-webgl",
    "prismarine-physics-bedrock": "github:mc-zuri/prismarine-physics#bedrock-web-viewer",
    "prismarine-schematic": "^1.2.0",
    "prismarine-viewer": "file:./",
    "process": "^0.11.10",
    "puppeteer": "^22.8.2",
    "standard": "^17.1.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "minecraft-data": "$minecraft-data",
    "minecraft-assets": "$minecraft-assets",
    "prismarine-block": "$prismarine-block",
    "prismarine-chunk": "$prismarine-chunk",
    "prismarine-registry": "$prismarine-registry"
  }
}
